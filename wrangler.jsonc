{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxscratchpad",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [
    {
      "pattern": "taxscratchpad.npux.design",
      "custom_domain": true,
    },
  ],
}
